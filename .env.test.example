# Copy to .env.test (gitignored). MySQL only — Neon hosts PostgreSQL, not MySQL.
#
# Option A — Docker (recommended): docker compose -f docker-compose.test.yml up -d
DATABASE_URL="mysql://root:test_root_password@127.0.0.1:3307/nail_salon_test"
#
# Option B — your local MySQL 97 service (use your real root password / port)
# DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/nail_salon_test"
JWT_SECRET="test-jwt-secret-at-least-32-characters-long-for-tests"
SMS_PROVIDER="console"
MOCK_OTP="true"
CRON_SECRET="test-cron-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3100"
