# Local development (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nail_salon"

# Auth — generate a long random string for production
JWT_SECRET="change-this-to-a-long-random-secret"

# Neon PostgreSQL (production — https://neon.tech)
# Use the pooled connection string for the app (host contains "-pooler")
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: SMS (Kavenegar). Default `console` = no real SMS, mock OTP 123456
# SMS_PROVIDER="console"
# MOCK_OTP="true"
# KAVENEGAR_API_KEY=""

# Optional: ZarinPal online payment (omit for dev mock payments)
# ZARINPAL_MERCHANT_ID=""
# ZARINPAL_SANDBOX="true"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
