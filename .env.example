# Local development (MySQL). Prisma provider is mysql — Neon/PostgreSQL URLs will not work.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nail_salon"

# Integration / e2e tests: copy this file to .env.test with a *separate* MySQL database
# (name must end with _test, e.g. nail_salon_test). Do not use Neon here — see docs/testing.md.
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nail_salon_test"
# JWT_SECRET="test-jwt-secret-at-least-32-characters-long-for-tests"
# SMS_PROVIDER="console"
# MOCK_OTP="true"
# CRON_SECRET="test-cron-secret"
# NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Auth — required in production
JWT_SECRET="change-this-to-a-long-random-secret"

# SMS (Kavenegar via SMS_API_KEY). Default `console` = no real SMS, mock OTP 123456
# SMS_PROVIDER="console"
# MOCK_OTP="true"
# SMS_API_KEY=""
# SMS_API_URL=""

# ZarinPal online payment (omit merchant id + set ENABLE_MOCK_PAYMENTS=true for local mock)
# ZARINPAL_MERCHANT_ID=""
# ZARINPAL_SANDBOX="true"
# ENABLE_MOCK_PAYMENTS="true"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scheduled SMS jobs (POST /api/cron/sms with Authorization: Bearer CRON_SECRET)
# CRON_SECRET="change-this-to-a-long-random-secret"
