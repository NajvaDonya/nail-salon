generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  STAFF
  CUSTOMER
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Salon {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  phone        String?
  address      String?
  city         String?
  openingHours Json?
  settings     Json?
  isActive     Boolean  @default(true)
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User?         @relation("SalonOwner", fields: [ownerId], references: [id])
  users        User[]        @relation("SalonUsers")
  services     Service[]
  staff        Staff[]
  appointments Appointment[]
  vacations    Vacation[]
  workingHours WorkingHour[]
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?
  firstName    String?
  lastName     String?
  name         String    @default("")
  passwordHash String?
  avatar       String?
  role         Role
  salonId      String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salon         Salon?        @relation("SalonUsers", fields: [salonId], references: [id])
  ownedSalons   Salon[]       @relation("SalonOwner")
  staffMembers  Staff[]
  appointments  Appointment[] @relation("CustomerAppointments")
  reviews       Review[]
  otpCodes      OtpCode[]
}

model Staff {
  id          String   @id @default(cuid())
  userId      String
  salonId     String
  specialties Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  salon        Salon              @relation(fields: [salonId], references: [id])
  services     StaffService[]
  appointments Appointment[]
  reviews      Review[]
  vacations    StaffVacation[]
  workingHours StaffWorkingHour[]

  @@unique([userId, salonId])
}

model Service {
  id            String  @id @default(cuid())
  salonId       String
  name          String
  duration      Int
  price         Int
  discountPrice Int?
  category      String
  bufferTime    Int     @default(0)
  isActive      Boolean @default(true)

  salon               Salon                @relation(fields: [salonId], references: [id])
  staffServices       StaffService[]
  appointmentServices AppointmentService[]

  @@unique([salonId, name])
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model WorkingHour {
  id        String  @id @default(cuid())
  salonId   String
  dayOfWeek String
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  salon Salon @relation(fields: [salonId], references: [id])

  @@unique([salonId, dayOfWeek])
}

model StaffWorkingHour {
  id        String  @id @default(cuid())
  staffId   String
  dayOfWeek String
  startTime String
  endTime   String
  isOff     Boolean @default(false)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  userId    String?
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Appointment {
  id           String            @id @default(cuid())
  salonId      String
  customerId   String
  staffId      String
  date         DateTime          @db.Date
  startTime    DateTime
  endTime      DateTime
  totalPrice   Int
  status       AppointmentStatus @default(PENDING)
  trackingCode String?           @unique
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  salon    Salon                @relation(fields: [salonId], references: [id])
  customer User                 @relation("CustomerAppointments", fields: [customerId], references: [id])
  staff    Staff                @relation(fields: [staffId], references: [id])
  services AppointmentService[]
  reviews  Review[]
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
}

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  customerId    String
  staffId       String
  rating        Int
  comment       String?
  reply         String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  customer    User        @relation(fields: [customerId], references: [id])
  staff       Staff       @relation(fields: [staffId], references: [id])
}

model Vacation {
  id        String   @id @default(cuid())
  salonId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  salon Salon @relation(fields: [salonId], references: [id])
}

model StaffVacation {
  id        String   @id @default(cuid())
  staffId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}
