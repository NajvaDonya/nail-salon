generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  STAFF
  CUSTOMER
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  AWAITING_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PendingApprovalType {
  NONE
  UPDATE
  DELETE
}

enum AppointmentKind {
  SERVICE
  LUNCH
}

enum VisitTypeBehavior {
  GENERAL
  FIRST_TIME
  RETURNING
  PREFERRED_STAFF
}

enum ServiceKind {
  BASE
  ADDON
}

enum SmsType {
  OTP
  REMINDER
  POST_SERVICE
  REVIEW_REQUEST
  CONFIRMATION
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

model Salon {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  phone        String?
  address      String?
  city         String?
  openingHours Json?
  settings     Json?
  isActive     Boolean  @default(true)
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User?         @relation("SalonOwner", fields: [ownerId], references: [id])
  users        User[]        @relation("SalonUsers")
  services     Service[]
  staff        Staff[]
  appointments Appointment[]
  vacations    Vacation[]
  workingHours WorkingHour[]
  slotHolds    SlotHold[]
  visitTypes   VisitType[]
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?
  firstName    String?
  lastName     String?
  name         String    @default("")
  passwordHash String?
  avatar       String?
  role         Role
  salonId      String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salon         Salon?        @relation("SalonUsers", fields: [salonId], references: [id])
  ownedSalons   Salon[]       @relation("SalonOwner")
  staffMembers  Staff[]
  appointments  Appointment[] @relation("CustomerAppointments")
  reviews       Review[]
  otpCodes      OtpCode[]
}

model Staff {
  id          String   @id @default(cuid())
  userId      String
  salonId     String
  specialties Json?
  isActive    Boolean  @default(true)
  restMinutes Int      @default(0)
  lunchStart  String?
  lunchEnd    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  salon        Salon              @relation(fields: [salonId], references: [id])
  services     StaffService[]
  appointments Appointment[]
  reviews      Review[]
  vacations    StaffVacation[]
  workingHours StaffWorkingHour[]
  slotHolds    SlotHold[]

  @@unique([userId, salonId])
}

model VisitType {
  id          String            @id @default(cuid())
  salonId     String
  name        String
  description String?
  sortOrder   Int               @default(0)
  behavior    VisitTypeBehavior @default(GENERAL)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([salonId, name])
}

model Service {
  id            String      @id @default(cuid())
  salonId       String
  name          String
  duration      Int
  price         Int
  discountPrice Int?
  depositAmount Int         @default(0)
  category      String
  bufferTime    Int         @default(0)
  kind          ServiceKind @default(BASE)
  allowQuantity Boolean     @default(false)
  maxQuantity   Int?
  isActive      Boolean     @default(true)

  salon               Salon                @relation(fields: [salonId], references: [id])
  staffServices       StaffService[]
  appointmentServices AppointmentService[]
  addonLinks          ServiceAddon[]       @relation("BaseService")
  linkedAsAddon       ServiceAddon[]       @relation("AddonService")

  @@unique([salonId, name])
}

model ServiceAddon {
  id             String @id @default(cuid())
  baseServiceId  String
  addonServiceId String

  baseService  Service @relation("BaseService", fields: [baseServiceId], references: [id], onDelete: Cascade)
  addonService Service @relation("AddonService", fields: [addonServiceId], references: [id], onDelete: Cascade)

  @@unique([baseServiceId, addonServiceId])
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model WorkingHour {
  id        String  @id @default(cuid())
  salonId   String
  dayOfWeek String
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  salon Salon @relation(fields: [salonId], references: [id])

  @@unique([salonId, dayOfWeek])
}

model StaffWorkingHour {
  id        String  @id @default(cuid())
  staffId   String
  dayOfWeek String
  startTime String
  endTime   String
  isOff     Boolean @default(false)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  userId    String?
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, isUsed, expiresAt])
}

model Appointment {
  id               String            @id @default(cuid())
  salonId          String
  customerId       String
  staffId          String
  visitTypeId      String?
  preferredStaffId String?
  date             DateTime          @db.Date
  startTime        DateTime
  endTime          DateTime
  totalPrice       Int
  depositAmount    Int               @default(0)
  balanceDue       Int               @default(0)
  status           AppointmentStatus   @default(PENDING)
  kind             AppointmentKind     @default(SERVICE)
  pendingApproval  PendingApprovalType @default(NONE)
  pendingChanges   Json?
  trackingCode     String?             @unique
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  salon     Salon                @relation(fields: [salonId], references: [id])
  customer  User                 @relation("CustomerAppointments", fields: [customerId], references: [id])
  staff     Staff                @relation(fields: [staffId], references: [id])
  visitType VisitType?           @relation(fields: [visitTypeId], references: [id], onDelete: SetNull)
  services  AppointmentService[]
  reviews   Review[]
  payment   Payment?
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String
  serviceName   String  @default("")
  price         Int     @default(0)
  finalPrice    Int     @default(0)
  duration      Int     @default(0)
  bufferTime    Int     @default(0)
  depositAmount Int     @default(0)
  quantity      Int     @default(1)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
}

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  customerId    String
  staffId       String
  rating        Int
  comment       String?
  reply         String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  customer    User        @relation(fields: [customerId], references: [id])
  staff       Staff       @relation(fields: [staffId], references: [id])
}

model Vacation {
  id        String   @id @default(cuid())
  salonId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  salon Salon @relation(fields: [salonId], references: [id])
}

model StaffVacation {
  id        String   @id @default(cuid())
  staffId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model SlotHold {
  id        String   @id @default(cuid())
  salonId   String
  staffId   String
  date      DateTime @db.Date
  startTime String
  endTime   String
  holdToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date, startTime])
  @@index([holdToken])
  @@index([expiresAt])
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  amount        Int
  status        PaymentStatus @default(PENDING)
  authority     String?       @unique
  refId         String?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
}

model SmsLog {
  id            String    @id @default(cuid())
  appointmentId String?
  phone         String
  type          SmsType
  status        SmsStatus @default(PENDING)
  message       String    @db.Text
  attempts      Int       @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([appointmentId, type])
  @@index([status, createdAt])
}
